# Where Ollama is running
OLLAMA_HOST=http://localhost:11434

# Chat model: needs tool-calling support for agent mode (llama3.1, qwen2.5, mistral-nemo...)
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.2

# auto = tool-calling agent, falls back to classic RAG if the model lacks tools
# rag  = always retrieve-then-answer (faster, works with any model)
AGENT_MODE=auto
# In agent mode, force a search if the model tries to answer without one
REQUIRE_RETRIEVAL=true
MAX_STEPS=4
HISTORY_TURNS=4

# Vector DB + retrieval
CHROMA_DIR=./data/chroma
COLLECTION=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Cosine similarity below this counts as "not grounded" on the dashboard
MIN_SCORE=0.45

METRICS_DB=./data/metrics.db
